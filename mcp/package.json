{
  "name": "planny-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for planny: publish an HTML plan, get a link and a delete key.",
  "license": "MIT",
  "author": "Fraser Griffiths",
  "type": "module",
  "bin": {
    "planny-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun run src/index.ts",
    "e2e": "bun run scripts/e2e.ts",
    "verify": "bun run build && bun run e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frasergriffiths/planny.git",
    "directory": "mcp"
  }
}
