# Vercel build. Copy to .env.local (never commit real values); `vercel env pull` fills these in.
PLANNY_ADDRESS_KEY=          # random secret for hashing client addresses, e.g. openssl rand -base64 32
PLANNY_PUBLIC_ORIGIN=https://planny-pink.vercel.app
BLOB_READ_WRITE_TOKEN=       # private Blob store token, set by Vercel
UPSTASH_REDIS_REST_URL=      # Upstash Redis from the Vercel Marketplace
UPSTASH_REDIS_REST_TOKEN=
GLOBAL_CONFIG=               # Global Config connection string; holds the uploadsEnabled key

# Optional overrides (defaults are in src/config.js)
# PLANNY_MAX_PLAN_YEARS=100
# PLANNY_CACHE_TTL_SECONDS=300
# PLANNY_SITE_BYTES=838860800
# PLANNY_OWNER_BYTES=41943040
# PLANNY_MONTHLY_UPLOADS=1500
# PLANNY_MONTHLY_READS=8000
# PLANNY_MONTHLY_READ_BYTES=8000000000
