# TypeScript build. Copy to .env.local for local runs; never commit real values.
PLANNY_ADDRESS_KEY=          # required; stable secret for hashing client addresses, e.g. openssl rand -base64 32
PLANNY_PUBLIC_ORIGIN=https://planny-pink.vercel.app
PLANNY_ADMIN_TOKEN=          # required; operator token for /admin routes, e.g. openssl rand -hex 32
PLANNY_BLOB_KEY_1=           # required for a public Blob store; stable HMAC key, do not rotate
BLOB_READ_WRITE_TOKEN=       # required; Blob read-write token, Production only
BLOB_ACCESS=public           # public or private; public needs PLANNY_BLOB_KEY_1
# BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY are connection metadata, not app config.

# Launch limits (defaults shown)
# PLANNY_MAX_PLAN_YEARS=100
# PLANNY_CACHE_TTL_SECONDS=3600
# PLANNY_SITE_BYTES=104857600
# PLANNY_OWNER_BYTES=1073741824
# PLANNY_OWNER_MONTHLY_READ_BYTES=10737418240
# PLANNY_MONTHLY_UPLOADS=5000
# PLANNY_MONTHLY_READS=1500000
# PLANNY_MONTHLY_READ_BYTES=214748364800
