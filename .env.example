# planny environment template.
# Copy to .env.local for local work; set production values in Vercel.
# Never commit real values. The Blob token can read and change the store; the admin
# token authorises takedown and reset calls.

# Storage selector: blob (default) or postgres.
# PLANNY_STORE=blob

# Core: Vercel Blob, used when PLANNY_STORE is unset or blob.
BLOB_READ_WRITE_TOKEN=       # required in Blob mode; the Blob read-write token. Treat it as a full-store secret.
BLOB_ACCESS=private          # private is the safe default. public exposes every object at its Blob URL.
PLANNY_BLOB_KEY_1=           # set a stable HMAC key for a public store; if unset, the Blob token is used and rotation breaks links.

# Core: Postgres (Neon), used only when PLANNY_STORE=postgres.
# DATABASE_URL=             # Neon connection string, including sslmode=require.
# PLANNY_ADDRESS_KEY is required in Postgres mode and remains the HMAC secret.

# Core: app.
PLANNY_PUBLIC_ORIGIN=https://use-planny.vercel.app  # canonical origin for returned links; set this for a self-hosted instance.
PLANNY_ADDRESS_KEY=          # recommended; if unset, the Blob token is used; rotating it resets all rates. e.g. openssl rand -base64 32.
PLANNY_ADMIN_TOKEN=          # required for takedown/reset, optional for serving and publishing. e.g. openssl rand -hex 32.

# Vercel Blob connection metadata (not app config).
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=

# Limits: defaults shown. Set only when the value needs to change.
# PLANNY_MAX_PLAN_YEARS=100
# PLANNY_CACHE_TTL_SECONDS=3600
# PLANNY_SITE_BYTES=107374182400
# PLANNY_OWNER_BYTES=1073741824
# PLANNY_OWNER_MONTHLY_READ_BYTES=10737418240
# PLANNY_MONTHLY_UPLOADS=5000
# PLANNY_MONTHLY_READS=1500000
# PLANNY_MONTHLY_READ_BYTES=214748364800
# PLANNY_UPLOADS_PER_DAY=50
# PLANNY_UPLOADS_PER_MONTH=500
# PLANNY_UPLOAD_SPACING_SECONDS=120
# PLANNY_RATE_VIEWS_MAX=20
# PLANNY_RATE_VIEWS_WINDOW=60
# PLANNY_RATE_UPLOADS_MAX=20
# PLANNY_RATE_UPLOADS_WINDOW=3600
# PLANNY_CLAIM_STALE_SECONDS=900

# Viewer attribution: on (default) shows the "Made with Planny" footer on every plan and
# the publish line on 404/410 pages. Set off for a self-hosted instance that should not
# advertise the hosted service. Aliases: off also accepts 0, false, no, disable,
# disabled, none; on also accepts 1, true, yes, enabled.
# PLANNY_ATTRIBUTION=on

# Local only. The local server uses SQLite and a data folder, not the Blob store.
# PLANNY_DATA_DIR=~/Library/Application Support/planny-local
# PLANNY_LOCAL_PORT=4317
# PLANNY_BUILD=local

# Set by the platform/runtime; do not set by hand in production.
# PLANNY_BUILD=vercel
# PLANNY_SHA=
