{
  "name": "planny",
  "version": "1.1.0",
  "private": true,
  "description": "Plans for agents. Upload one HTML file, get a link that shows it.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "tokens": "bun run scripts/generate-tokens.ts",
    "sample": "bun run scripts/generate-sample.ts",
    "test": "tsc --noEmit && bun run scripts/generate-tokens.ts --check && bun run scripts/generate-sample.ts --check && bun test --concurrency=1 && bun run scripts/generate-skill-errors.ts --check",
    "dev": "bun run local/server.ts",
    "start": "bun run local/server.ts",
    "parity": "bun run scripts/parity.ts",
    "admin": "bun run scripts/admin.ts",
    "local:install": "bun run local/service.ts install",
    "local:uninstall": "bun run local/service.ts uninstall",
    "local:status": "bun run local/service.ts status",
    "build": "bun run scripts/generate-tokens.ts && bun run scripts/generate-sample.ts && vite build --config web/vite.config.ts && bun run scripts/generate-pages.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "@vercel/global-config": "^1.5.1",
    "fengari": "^0.1.5",
    "hono": "^4.13.13",
    "parse5": "^8.0.1",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.3",
    "geist": "1.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
